{
  "manifest_version": 3,
  "name": "PaperTrench",
  "version": "2.3.0",
  "description": "Paper-trade Solana memecoins with live P&L, native chart fills, session replay, AI coaching, and a verifiable track record.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "offscreen",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "classic"
  },
  "content_scripts": [
    {
      "matches": [
        "https://axiom.trade/*",
        "https://*.axiom.trade/*",
        "https://*.padre.gg/*",
        "https://*.tinyastro.io/*",
        "https://gmgn.ai/*",
        "https://*.gmgn.ai/*",
        "https://*.bullx.io/*",
        "https://dexscreener.com/*",
        "https://*.dexscreener.com/*",
        "https://birdeye.so/*",
        "https://*.birdeye.so/*",
        "https://jup.ag/*",
        "https://*.jup.ag/*",
        "https://pump.fun/*",
        "https://*.pump.fun/*"
      ],
      "js": [
        "price-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://axiom.trade/*",
        "https://*.axiom.trade/*",
        "https://*.padre.gg/*",
        "https://*.tinyastro.io/*",
        "https://gmgn.ai/*",
        "https://*.gmgn.ai/*",
        "https://*.bullx.io/*",
        "https://dexscreener.com/*",
        "https://*.dexscreener.com/*",
        "https://birdeye.so/*",
        "https://*.birdeye.so/*",
        "https://jup.ag/*",
        "https://*.jup.ag/*",
        "https://pump.fun/*",
        "https://*.pump.fun/*"
      ],
      "js": [
        "engine.js",
        "attest.js",
        "quote.js",
        "sites.js",
        "resolver.js",
        "chart-markers.js",
        "title-feed.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PaperTrench",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "price-bridge.js"
      ],
      "matches": [
        "https://axiom.trade/*",
        "https://*.padre.gg/*",
        "https://*.tinyastro.io/*",
        "https://gmgn.ai/*",
        "https://*.bullx.io/*",
        "https://dexscreener.com/*",
        "https://birdeye.so/*",
        "https://jup.ag/*",
        "https://pump.fun/*"
      ]
    }
  ],
  "options_page": "dashboard.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}